#include "Button_Driver.h"

void User_Button_Init(){
	GPIO_InitTypeDef BUTTON_Config;
	BUTTON_Config.Pin = BUTTON_PIN; // Pin Number
	BUTTON_Config.Mode = GPIO_MODE_INPUT; // Pin Mode
	BUTTON_Config.Speed = GPIO_SPEED_FREQ_HIGH; // Pin Speed
	BUTTON_Config.Pull = GPIO_NOPULL; // Pin Push up/ Pull Down Control

	__HAL_RCC_GPIOA_CLK_ENABLE();
	HAL_GPIO_Init(USER_BUTTON_PORT, &BUTTON_Config);
	HAL_NVIC_EnableIRQ(EXTI0_IRQn);
}


