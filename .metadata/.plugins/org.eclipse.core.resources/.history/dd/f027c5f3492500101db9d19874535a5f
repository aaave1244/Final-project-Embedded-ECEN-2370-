static bool check_if_middle_piece(uint8_t row, uint8_t col){
    if(Game_Board[row][col+1] == Game_Board[row][col] && Game_Board[row][col-1] == Game_Board[row][col]){
        return true;
    } else {
        return false;
    }
}
static bool check_if_top_piece(uint8_t row, uint8_t col){
    if(row<2){
        return false; //this is an edge case. I don't want to check for a top piece if we're at the top of the board.
    }
    if(Game_Board[row-1][col] == Game_Board[row][col] && Game_Board[row-2][col] == Game_Board[row][col]){
        return true;
    } else {
        return false;
    }
}
static bool check_if_leftmost_piece(uint8_t row, uint8_t col){
    if(col>=5){
        return false; //this is an edge case. I don't want to check for a leftmost piece if we're at the left side of the board.
    }
    if(Game_Board[row][col+1] == Game_Board[row][col] && Game_Board[row][col+2] == Game_Board[row][col]){
        return true;
    } else {
        return false;
    }
}
