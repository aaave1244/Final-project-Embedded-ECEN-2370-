static uint8_t check_all(uint8_t row, uint8_t col){
    if(check_if_middle_piece(row, col)==true){
        return 1;
    } else if(check_if_top_piece(row, col)==true){
        return 2;
    } else if(check_if_leftmost_piece(row, col)==true){
        return 3;
    } else if(check_if_rightmost_piece(row, col)==true){
        return 4;
    } else if(check_if_top_left_piece(row, col)==true){
        return 5;
    } else if(check_if_top_right_piece(row, col)==true){
        return 6;
    } else if(check_if_bottom_left_piece(row, col)==true){
        return 7;
    } else if(check_if_bottom_right_piece(row, col)==true){
        return 8;
    } else {
        return 0; //this means that there are no three pieces in a row around this point!
    }
}

uint8_t AI_col(uint8_t row, uint8_t col){ //just return the column the AI wants to drop the piece on! //pass in the last row and column a piece has landed on.
    //Game_Board[i][j]; //just make it look through game board with like 10 if statements and you'll have literally the best AI ever made
    
    if(Check_for_win(row, col) == 3){ //Go on defense
        //my plan is to check around to see if we're looking at the middle piece, then guess that we're looking at the leftmost piece (and lowest), then guess that we're the rightmost (and lowest) piece, then guess that we're the topmost (and leftmost) piece. then check top right most.
        if(check_if_middle_piece(row, col)==true){
            if(col>=5){ //(right) edge case
                return col-2; //drop it to the left of the left piece
            } else if(col<=1){//(left) edge case
                return col+2; //drop it to the right of the right piece
            } else { //general case
                if(Game_Board[row][col-2]==0){
                    return col-2;
                } else if(Game_Board[row][col+2]==0){
                    return col+2;
                }
                return col-2; //I'm gonna make this AI favour putting a piece as far left as possble to block the pieces. An easy way to win may be to set it up so that you can win by keeping a space open to the right?
            }
        } else if(check_if_top_piece(row, col)==true){
            return col; //drop it right on top baby!
        } else if(check_if_leftmost_piece(row, col)==true){
            if(col==0){ //edge case not caught by the check_if_leftmost_piece function
                return col+3;
            }
            if(Game_Board[row][col+3]==0){
                return col+3; //drop it to the right of the rightmost piece
            } else if(Game_Board[row][col-1]==0){
                return col-1; //drop it to the left of the left piece
            } else {
                return col-1; //I'm gonna make this AI favour putting a piece as far left as possble to block the pieces. An easy way to win may be to set it up so that you can win by keeping a space open to the right?
            }
        } else if(check_if_rightmost_piece(row, col)==true){
            if(col==6){ //edge case not caught by the check_if_leftmost_piece function
                return col-3;
            }
            if(col<=2){
                return col+1;
            }
            if(Game_Board[row][col-3]==0){
                return col-3; //drop it to the right of the left piece
            } else if(Game_Board[row][col+1]==0){
                return col+1; //drop it to the right of the right piece
            } else {
                return col-3; //I'm gonna make this AI favour putting a piece as far left as possble to block the pieces. An easy way to win may be to set it up so that you can win by keeping a space open to the right?
            }
        } else if(check_if_top_left_piece(row, col)==true){
            if(col<1){
                return col+3;
            } else {
                return col-1;
            }
        } else if(check_if_top_right_piece(row, col)==true){
            if(col>5){
                return col-3;
            } else {
                return col+1;
            }
        } else if(check_if_bottom_left_piece(row, col)==true){
            if(col<1){
                return col+3;
            } else {
                return col-1;
            }
        } else if(check_if_bottom_right_piece(row, col)==true){ //the diagonal checks are kind of bad rn lowkey. Maybe fix later!
            if(col>5){
                return col-3;
            } else {
                return col+1;
            }
        } else { //this SHOULDN'T HAPPEN. SET A BREAKPOINT HERE!!! (because the check_for_win function returned 3)
            return -1; //this is an error code. I don't want to use 0 because that is a valid value for the game board.
        }

    } else if(Check_for_win(row, col) <= 2){ //Go on offense
        for(uint8_t i = 5; (i>=0 && i!=255); i=i-1){
            for(uint8_t j = 0; j<7; j++){
                if(Game_Board[i][j] == 2){
                    if(check_all(i, j) == 1){ //this is the check for the middle piece. I want to make this a function that checks all of the pieces around it and returns the number of pieces in a row.
                        if(j>=5){ //(right) edge case
                            return j-2; //drop it to the left of the left piece
                        } else if(j<=1){//(left) edge case
                            return j+2; //drop it to the right of the right piece
                        } else { //general case
